{
	"version": "2.0.0",
	"tasks": [
		{
			"label": "Generate Makefiles",
			"type": "shell",
			"command": "premake5",
			"args": [
				"gmake"
			],
			"group": {
				"kind": "build",
				"isDefault": true
			}
		},
		{
			"label": "Build (Debug)",
			"type": "shell",
			"command": "make",
			"args": [
				"-C", "./Build",
				"config=debug"
			],
			"problemMatcher": [ "$gcc" ],
			"dependsOn": [
				"Generate Makefiles"
			]
		},
		{
			"label": "Build (Release)",
			"type": "shell",
			"command": "make",
			"args": [
				"-C", "./Build",
				"config=release"
			],
			"problemMatcher": [ "$gcc" ],
			"dependsOn": [
				"Generate Makefiles"
			]
		}
	]
}